# Copy this to .env and fill in your keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
PORT=3000

# Optional — your phone number for the resume header. Falls back to a
# placeholder if unset, so the app runs fine without it. Keep this in
# .env (gitignored), not in source.
RESUME_PHONE=+1 (555) 123-4567

